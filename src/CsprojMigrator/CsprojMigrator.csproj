<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>csproj-migrator</AssemblyName>
    <PackageId>csproj-migrator</PackageId>
    <RootNamespace>Aiglusoft.CsprojMigrator</RootNamespace>
    <Version>0.1.1</Version>
    <Authors>Imed Ben Youssef</Authors>
    <Company>Aiglusoft</Company>
    <Copyright>Copyright © 2026 Aiglusoft. Tous droits réservés.</Copyright>
    <Description>CLI automating .NET legacy to multi-target migration (A=source, B=reference, C=destination).</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>csproj-migrator</ToolCommandName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="YamlDotNet" Version="15.3.0" />
  </ItemGroup>
</Project>